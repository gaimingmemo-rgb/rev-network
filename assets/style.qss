/* IMPERIAL REV-LAUNCHER AESTHETIC QSS */

QMainWindow {
    background-color: #090a0d;
    color: #e0e6ed;
    border: 1px solid #7a0c18;
}

QWidget {
    font-family: 'Segoe UI', 'Roboto', 'Arial', sans-serif;
    color: #e0e6ed;
}

/* Custom Rev-Launcher Titlebar */
#ImperialTitleBar {
    background-color: #0f1218;
    border-bottom: 2px solid #8a0e1c;
    min-height: 40px;
    max-height: 40px;
}

#TitleBarLabel {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 3px;
    color: #ffffff;
    text-transform: uppercase;
    padding-left: 8px;
}

#TitleBarTelemetry {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #ff334b;
    padding-right: 15px;
}

/* Title Bar Animated Action Buttons */
#TitleWebsiteBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a1f24, stop:1 #061114);
    border: 1px solid #00f0ff;
    color: #00f0ff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 5px 11px;
    border-radius: 4px;
    margin-right: 6px;
}

#TitleWebsiteBtn:hover {
    background: #00f0ff;
    border-color: #ffffff;
    color: #06090f;
}

#TitleReleasesBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #261608, stop:1 #140b03);
    border: 1px solid #ffb703;
    color: #ffb703;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 5px 11px;
    border-radius: 4px;
    margin-right: 6px;
}

#TitleReleasesBtn:hover {
    background: #ffb703;
    border-color: #ffffff;
    color: #06090f;
}

#TitleDiscordBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1a1e38, stop:1 #0f1224);
    border: 1px solid #5865F2;
    color: #a4afff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 5px 11px;
    border-radius: 4px;
    margin-right: 10px;
}

#TitleDiscordBtn:hover {
    background: #5865F2;
    border-color: #8c97ff;
    color: #ffffff;
}

/* Google Header Button */
#GoogleHeaderBtn {
    background: linear-gradient(180deg, #181d29 0%, #11141d 100%);
    border: 1px solid #8a0e1c;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    padding: 5px 12px;
    border-radius: 4px;
    margin-right: 15px;
}

#GoogleHeaderBtn:hover {
    background: #ff1e38;
    border-color: #ff4d61;
    color: #ffffff;
    box-shadow: 0 0 10px rgba(255, 30, 56, 0.6);
}

/* Navigation Toolbar */
#ImperialNavToolBar {
    background-color: #11141c;
    border-bottom: 1px solid #1f232f;
    padding: 5px 10px;
    spacing: 6px;
    min-height: 44px;
}

/* Tactical Nav Buttons */
QToolButton, QPushButton {
    background-color: #161922;
    color: #cfd7e3;
    border: 1px solid #282e3d;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

QToolButton:hover, QPushButton:hover {
    background-color: #1e2330;
    border-color: #ff1e38;
    color: #ffffff;
}

QToolButton:pressed, QPushButton:pressed {
    background-color: #ff1e38;
    color: #ffffff;
}

/* Search Engine Dropdown */
#SearchEngineCombo {
    background-color: #161922;
    border: 1px solid #8a0e1c;
    border-radius: 4px;
    color: #ff1e38;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 10px;
    min-width: 110px;
}

#SearchEngineCombo::drop-down {
    border: none;
    width: 20px;
}

#SearchEngineCombo QAbstractItemView {
    background-color: #11141c;
    border: 1px solid #8a0e1c;
    color: #e0e6ed;
    selection-background-color: #1e2330;
    selection-color: #ff1e38;
}

/* Rev Community Button */
#CommunityBtn {
    background: linear-gradient(180deg, #181d29 0%, #12151e 100%);
    border: 1px solid #ff1e38;
    color: #ff3b52;
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 1.5px;
    border-radius: 4px;
    padding: 6px 12px;
}

#CommunityBtn:hover {
    background: #ff1e38;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(255, 30, 56, 0.6);
}

/* Tactical RAM Purge Button */
#PurgeRamBtn {
    background-color: rgba(255, 30, 56, 0.12);
    border: 1px solid #8a0e1c;
    color: #ff4d61;
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 1.5px;
    border-radius: 4px;
    padding: 6px 10px;
}

#PurgeRamBtn:hover {
    background-color: #ff1e38;
    color: #ffffff;
    border-color: #ff4d61;
}

/* Shield Badge Button */
#ShieldBtn {
    background-color: rgba(0, 240, 255, 0.08);
    border: 1px solid #008899;
    color: #00f0ff;
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 1px;
    border-radius: 4px;
    padding: 6px 10px;
}

#ShieldBtn:hover {
    background-color: #00f0ff;
    color: #000000;
}

/* Settings Button */
#SettingsBtn {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid #363c50;
    color: #e0e6ed;
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 1px;
    border-radius: 4px;
    padding: 6px 10px;
}

#SettingsBtn:hover {
    background-color: #252a3a;
    border-color: #ff1e38;
    color: #ffffff;
}

/* Omnibox */
#ImperialAddressBar {
    background-color: #0b0d13;
    color: #ffffff;
    border: 1px solid #282f40;
    border-radius: 4px;
    padding: 6px 12px;
    font-size: 13px;
    selection-background-color: #ff1e38;
    selection-color: #ffffff;
}

#ImperialAddressBar:focus {
    border: 1px solid #ff1e38;
    background-color: #0f121a;
}

/* Tab Bar */
QTabBar {
    background-color: #0d0f15;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #12151e;
    color: #8c97aa;
    border: 1px solid #1f2430;
    border-bottom: none;
    padding: 7px 18px;
    min-width: 140px;
    max-width: 220px;
    font-size: 11px;
    font-weight: 600;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover {
    background-color: #181d2a;
    color: #e0e6ed;
    border-top: 2px solid #8a0e1c;
}

QTabBar::tab:selected {
    background-color: #191d29;
    color: #ffffff;
    border-top: 3px solid #ff1e38;
    font-weight: bold;
}

/* New Tab Button */
#NewTabBtn {
    background-color: #161a24;
    color: #ff334b;
    border: 1px solid #282e3d;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 900;
    min-width: 28px;
    max-width: 28px;
    min-height: 26px;
    max-height: 26px;
}

#NewTabBtn:hover {
    background-color: #ff1e38;
    color: #ffffff;
    border-color: #ff1e38;
}

/* Status Bar */
QStatusBar {
    background-color: #0c0e14;
    border-top: 1px solid #1c202a;
    color: #7a8699;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    min-height: 26px;
}

QStatusBar QLabel {
    padding: 0 10px;
}

/* Dialogs */
QDialog {
    background-color: #0b0d13;
    border: 1px solid #8a0e1c;
    color: #ffffff;
}

QListWidget {
    background-color: #0a0c10;
    border: 1px solid #232836;
    color: #e0e6ed;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #191c26;
}

QListWidget::item:hover {
    background-color: #181c28;
    color: #ff334b;
}

QListWidget::item:selected {
    background-color: #212636;
    border-left: 3px solid #ff1e38;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0b0d12;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #252b3b;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #ff1e38;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
